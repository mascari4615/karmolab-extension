{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "KarmoLab",
  "version": "0.4.0",
  "description": "__MSG_extDescription__",
  "default_locale": "ko",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "activeTab", "scripting", "offscreen", "alarms"],
  "optional_permissions": ["tabCapture"],
  "minimum_chrome_version": "116",
  "background": { "service_worker": "dev/reload-worker.mjs", "type": "module" },
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "host_permissions": ["https://www.youtube.com/*", "http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["features/shorts-count.js", "features/shorts-date.js", "features/keyword-core.js", "features/density-core.js", "features/density.js", "features/home-size.js", "features/block-undo.js", "features/filter-review.js", "features/user-block.js", "features/comment-tools.js", "features/settings-backup.js", "features/keyword-comments.js", "features/comment-translate.js", "features/youtube-panel.js"],
      "css": ["features/shorts-date.css", "features/user-block.css", "features/keyword-comments.css", "features/density.css", "features/youtube-panel.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "KarmoLab",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "homepage_url": "https://lab.mascari4615.com/"
}
